# ============================================
# 根环境变量（docker compose 编排用）
# 复制为 .env 并按需调整
# 端口统一编号：server 3301 起，前端 3302 起，基础设施 5432/6379
# ============================================

# ---- 端口（统一编号，避免与本地其他项目冲突）----
SERVER_PORT=3301
ADMIN_PORT=3302
POSTGRES_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8080

# ---- PostgreSQL（开发默认值，生产必须改强密码）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monorepo_starter

# ---- JWT 密钥（生产必填，至少 16 字符）----
# JWT_SECRET=change-me-to-a-long-random-secret

# ---- 生产编排（docker-compose.prod.yml 用）----
# 镜像仓库与 tag（IMAGE_REPOSITORY_OWNER / IMAGE_TAG 必填，`${VAR:?}` fail-fast）
# IMAGE_REGISTRY=ghcr.io
# IMAGE_REPOSITORY_OWNER=your-org
# IMAGE_TAG=v1.2.3   # 禁止 latest；deploy.yml 部署时会注入真实版本
# 允许跨域访问的 origin（逗号分隔）
# CORS_ORIGINS=https://admin.example.com
# 日志级别
# LOG_LEVEL=info

# ---- 上传文件目录（server 容器内路径；prod compose 已设 /app/uploads）----
# UPLOAD_DIR=/app/uploads
