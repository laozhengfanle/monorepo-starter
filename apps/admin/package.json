{
  "name": "@starter/admin",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:admin",
      "type:app"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "@starter/api-client:generate-api"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "@starter/api-client:generate-api"
        ],
        "inputs": [
          "default",
          "{workspaceRoot}/packages/shared/api-client/src/**/*"
        ]
      }
    }
  },
  "dependencies": {
    "@ant-design/icons": "catalog:",
    "@apollo/client": "catalog:",
    "@starter/api-client": "workspace:*",
    "@starter/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-text-align": "catalog:",
    "@tiptap/extension-underline": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "antd": "catalog:",
    "dompurify": "catalog:",
    "echarts": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-codegen/typescript-react-apollo": "catalog:"
  }
}
