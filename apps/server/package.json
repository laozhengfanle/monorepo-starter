{
  "name": "@starter/server",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "server",
    "tags": [
      "scope:server",
      "type:app"
    ],
    "targets": {
      "prisma-generate": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/server",
          "command": "prisma generate",
          "env": {
            "DISABLE_ERD": "true"
          }
        },
        "inputs": [
          "{projectRoot}/prisma/schema.prisma"
        ],
        "outputs": [
          "{projectRoot}/src/generated/**"
        ],
        "cache": true
      },
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prisma-generate",
          "^build"
        ],
        "options": {
          "command": "webpack-cli build",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/server"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/server/dist/package.json",
          "{workspaceRoot}/apps/server/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/server/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "server:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "server:build:development"
          },
          "production": {
            "buildTarget": "server:build:production"
          }
        }
      },
      "generate-openapi": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/server",
          "command": "node dist/main.js",
          "env": {
            "OPENAPI_OUT_PATH": "../../openapi/openapi.json"
          }
        },
        "outputs": [
          "{workspaceRoot}/openapi/openapi.json"
        ],
        "cache": true
      }
    }
  },
  "dependencies": {
    "@apollo/server": "catalog:",
    "@as-integrations/express5": "catalog:",
    "@nestjs/apollo": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-socket.io": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@nestjs/websockets": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@starter/contracts": "workspace:*",
    "@starter/server-core": "workspace:*",
    "@willsoto/nestjs-prometheus": "catalog:",
    "bcrypt": "catalog:",
    "compression": "catalog:",
    "cookie-parser": "catalog:",
    "dataloader": "catalog:",
    "express": "catalog:",
    "graphql": "catalog:",
    "graphql-depth-limit": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "multer": "catalog:",
    "nestjs-pino": "catalog:",
    "nestjs-zod": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "pino-pretty": "catalog:",
    "prom-client": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "socket.io": "catalog:",
    "tslib": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@types/bcrypt": "catalog:",
    "@types/express": "catalog:",
    "@types/graphql-depth-limit": "catalog:",
    "@types/ioredis": "catalog:",
    "@types/multer": "catalog:",
    "@types/pg": "catalog:",
    "@types/pino-http": "catalog:",
    "prisma": "catalog:",
    "prisma-erd-generator": "catalog:",
    "socket.io-client": "catalog:",
    "tsx": "catalog:"
  }
}
