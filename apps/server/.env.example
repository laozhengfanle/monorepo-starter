# 复制为 .env 并按需调整
NODE_ENV=development
PORT=3301
LOG_LEVEL=log
# PostgreSQL 连接串（Prisma driver adapter 使用）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monorepo_starter?schema=public
# 允许跨域访问的 origin（逗号分隔）；未配置时默认仅放行 http://localhost:3302
# CORS_ORIGINS=https://admin.example.com,http://localhost:3302
# JWT 签名密钥（认证，至少 16 字符）
JWT_SECRET=change-me-to-a-long-random-secret
# JWT 过期时间（秒，默认 900 = 15 分钟）
JWT_ACCESS_TTL=900
# 登录锁定（可选，有默认值）：账号失败阈值 / IP 失败阈值 / 锁定窗口秒
# LOGIN_LOCK_ACCOUNT_THRESHOLD=5
# LOGIN_LOCK_IP_THRESHOLD=50
# LOGIN_LOCK_TTL=900
# Turnstile 人机验证（可选）：dev 本地 bypass 显式开关（仅 NODE_ENV=development 且为 1/true 时生效，默认关闭）
# TURNSTILE_DEV_BYPASS=1
# /metrics 端点 IP 白名单（逗号分隔，如 10.0.0.0/8 不支持、写具体 IP）；默认空 = 仅本机 127.0.0.1/::1
# METRICS_ALLOWED_IPS=127.0.0.1,::1
