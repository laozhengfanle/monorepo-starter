generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}

// ERD 生成器：docs workflow 用（pnpm erd:generate 生成 docs/erd.md，mermaid 格式）
// - 输出 .md（mermaid 代码块），不需要 puppeteer/mermaid-cli 渲染
// - 常规 build 通过 DISABLE_ERD=true 跳过（见 server 的 prisma-generate target）
generator erd {
  provider = "prisma-erd-generator"
  output   = "../../../docs/erd.md"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 用户体系（阶段 3）：Account 统一身份容器 + 多登录标识 + 档案 + RBAC
// ============================================================

/// 统一账户表 — 身份容器，不存登录标识和密码
model Account {
  id           String    @id @db.Uuid
  userType     String    @map("user_type") @db.VarChar(10)
  enabled      Boolean   @default(true)
  /// token 版本号：重置密码/软删/踢人时 increment → 所有旧 token 失效
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  identities   AccountIdentity[]
  adminProfile AdminProfile?
  adminRoles   AdminAccountRole[]
  tokenRevocations TokenRevocation[]
  auditLogs        AuditLog[]
  uploadFiles      UploadFile[]
  adminAccountMenus AdminAccountMenu[]

  @@index([userType])
  @@map("account")
}

/// 登录标识表 — 一个账户可有多种登录方式（username/password、phone、email、oauth）
model AccountIdentity {
  id           String    @id @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  identityType String    @map("identity_type") @db.VarChar(20)
  identifier   String    @db.VarChar(255)
  credential   String?   @db.Text
  verified     Boolean   @default(false)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([identityType, identifier])
  @@index([accountId])
  @@map("account_identity")
}

/// 管理端档案 — 只存业务数据（登录标识在 account_identity）
model AdminProfile {
  id        String    @id @db.Uuid
  accountId String    @unique @map("account_id") @db.Uuid
  nickname  String    @default("") @db.VarChar(50)
  phone     String    @default("") @db.VarChar(20)
  email     String    @default("") @db.VarChar(100)
  avatar    String    @default("") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("admin_profile")
}

/// 管理端角色 — code 为机器唯一编码（如 super_admin）
model AdminRole {
  id          String   @id @db.Uuid
  name        String   @db.VarChar(50)
  code        String   @unique @db.VarChar(50)
  description String   @default("") @db.VarChar(255)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  accountRoles AdminAccountRole[]
  roleMenus    AdminRoleMenu[]

  @@map("admin_role")
}

/// 管理端菜单/权限点（permissionCode）— type: directory/menu/button
model AdminMenu {
  id        String   @id @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(100)
  type      String   @db.VarChar(20)
  /// 权限机器编码，如 user:list / user:create；目录用 user-center 之类占位编码
  code      String   @unique @db.VarChar(100)
  /// 前端路由路径（仅 menu 类型），如 /admin/roles
  path      String?  @map("path") @db.VarChar(200)
  /// 前端图标名（仅 menu/directory 类型），如 TeamOutlined
  icon      String?  @db.VarChar(50)
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  /// 是否在侧栏显示（false = hideInMenu，如全局权限目录，对标 Vue visible）
  visible   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roleMenus AdminRoleMenu[]
  accountMenus AdminAccountMenu[]

  @@index([parentId])
  @@map("admin_menu")
}

/// 管理端 角色-权限点关联
model AdminRoleMenu {
  id     String @id @db.Uuid
  roleId String @map("role_id") @db.Uuid
  menuId String @map("menu_id") @db.Uuid

  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  menu AdminMenu @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@unique([roleId, menuId])
  @@map("admin_role_menu")
}

/// 管理端 账户-角色关联
model AdminAccountRole {
  id        String @id @db.Uuid
  accountId String @map("account_id") @db.Uuid
  roleId    String @map("role_id") @db.Uuid

  account Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  role    AdminRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([accountId, roleId])
  @@map("admin_account_role")
}

/// 管理端 账户额外权限覆盖 — grant 授权追加 / deny 禁止移除（对标老项目 AdminAccountMenu）
model AdminAccountMenu {
  id        String @id @db.Uuid
  accountId String @map("account_id") @db.Uuid
  menuId    String @map("menu_id") @db.Uuid
  type      String @default("grant") @db.VarChar(10)

  account Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  menu    AdminMenu @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@unique([accountId, menuId])
  @@map("admin_account_menu")
}

// ============================================================
// 认证增强（阶段 3）：token 撤销 + 审计
// ============================================================

/// Token 撤销记录 — 持久化"已撤销 token"清单（jti 精确匹配），Redis 兜底
model TokenRevocation {
  id        String   @id @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  /// JWT ID（payload.jti），精确匹配单个 token；'*' 表示该账号所有 token
  jti       String   @db.VarChar(128)
  /// 撤销原因：password_reset / password_changed / account_deleted / logout / token_reuse
  reason    String   @db.VarChar(50)
  /// 原 token 过期时间，过期后可清理
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([jti])
  @@index([accountId])
  @@index([expiresAt])
  @@map("token_revocation")
}

/// 安全审计日志 — 登录成功/失败/锁定、敏感操作
model AuditLog {
  id           String    @id @db.Uuid
  accountId    String?   @map("account_id") @db.Uuid
  action       String    @db.VarChar(50)
  resourceType String?   @map("resource_type") @db.VarChar(50)
  resourceId   String?   @map("resource_id") @db.Uuid
  detail       Json?
  ip           String?   @db.VarChar(50)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  account Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================================
// 文件上传（阶段 3）：本地磁盘存储 + 元数据记录
// ============================================================

/// 上传文件元数据表
model UploadFile {
  id           String    @id @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  originalName String    @map("original_name") @db.VarChar(255)
  /// 磁盘上的存储名（UUIDv7 + 扩展名，防冲突）
  storedName   String    @map("stored_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(100)
  size         BigInt
  /// 可访问 URL（/uploads/{storedName}）
  url          String    @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([createdAt])
  @@map("upload_file")
}

// ============================================================
// 数据字典（阶段 4）：字典类型 + 字典项，支撑可配置枚举（审计 action/资源类型/状态等）
// ============================================================

/// 字典类型 — 如 audit_action（审计操作）/ storage_driver（存储驱动）/ account_status（账户状态）
model SysDictType {
  id        String    @id @db.Uuid
  /// 字典类型编码（机器可读，唯一），如 audit_action
  code      String    @unique @db.VarChar(100)
  /// 字典类型名称（展示），如 审计操作类型
  name      String    @db.VarChar(100)
  remark    String?   @db.VarChar(255)
  enabled   Boolean   @default(true)
  sort      Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  items SysDictItem[]

  @@map("sys_dict_type")
}

/// 字典项 — 属于某字典类型下的一个可选项（label 展示 / value 存储）
model SysDictItem {
  id         String    @id @db.Uuid
  dictTypeId String    @map("dict_type_id") @db.Uuid
  /// 字典项标签（展示），如 登录成功
  label      String    @db.VarChar(100)
  /// 字典项值（存储），如 login_success
  value      String    @db.VarChar(100)
  remark     String?   @db.VarChar(255)
  enabled    Boolean   @default(true)
  sort       Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  dictType SysDictType @relation(fields: [dictTypeId], references: [id], onDelete: Cascade)

  @@index([dictTypeId])
  @@unique([dictTypeId, value])
  @@map("sys_dict_item")
}

// ============================================================
// 系统配置（阶段 4）：key-value JSON 键值存储，支撑后台设置/存储驱动/Turnstile 等
// ============================================================

/// 系统配置项 — 一行一个 key，value 为 JSON 对象（后台设置 settings / storage.driver / turnstile.config 等）
model SystemConfig {
  id        String    @id @db.Uuid
  /// 配置键（业务主键），如 settings / storage.driver / turnstile.config
  key       String    @unique @db.VarChar(100)
  /// 配置值（JSON 对象）
  value     Json
  remark    String?   @db.VarChar(255)
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  /// 软删除时间戳（查询过滤 deletedAt:null）
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("system_config")
}

// ============================================================
// 业务演示（阶段 1 保留）：User CRUD
// ============================================================

/// 用户表 — 阶段 1 演示 CRUD，验证数据层链路
model User {
  id        String    @id @db.Uuid
  username  String    @unique @db.VarChar(30)
  email     String    @unique @db.VarChar(100)
  role      String    @default("member") @db.VarChar(20)
  status    String    @default("active") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("user")
}
